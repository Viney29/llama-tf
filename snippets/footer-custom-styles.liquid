{% comment %}
  Footer custom styles — CSS overrides scoped to the footer section group.
  Rendered in layout/theme.liquid <head>.

  NOTE: The desktop grid rule assumes exactly 4 blocks in the footer section
  (3 menu columns + 1 newsletter group). If blocks are added/removed via the
  theme editor, the grid proportions may need updating.
{% endcomment %}

<style>
  /* ===================================================================
     FOOTER GROUP — desktop grid override
     Give 3 narrow menu columns + 1 wider newsletter column
     =================================================================== */
  @media screen and (min-width: 990px) {
    .shopify-section-group-footer .footer-content {
      grid-template-columns: repeat(3, minmax(160px, 1fr)) minmax(300px, 2fr);
    }
  }

  /* ===================================================================
     FOOTER GROUP — mobile reorder
     Move newsletter group (last child on desktop) above menu accordions
     =================================================================== */
  @media screen and (max-width: 749px) {
    .shopify-section-group-footer .footer-content {
      display: flex;
      flex-direction: column;
    }

    .shopify-section-group-footer .footer-content > :last-child {
      order: -1;
    }
  }

  /* ===================================================================
     FOOTER GROUP — social icon spacing (64px gap per design)
     =================================================================== */
  .shopify-section-group-footer .social-icons__wrapper {
    gap: 64px;
  }

  /* ===================================================================
     FOOTER GROUP — email signup button overrides
     Pill-shaped, uppercase, bold, min-width matching design
     =================================================================== */
  .shopify-section-group-footer .email-signup__button {
    border-radius: 24px;
    text-transform: uppercase;
    font-weight: 900;
    min-width: 200px;
  }

  /* ===================================================================
     FOOTER GROUP — email signup input overrides
     Pill-shaped input field matching design
     =================================================================== */
  .shopify-section-group-footer .email-signup__input {
    border-radius: 24px;
  }

  /* ===================================================================
     FOOTER GROUP — menu link hover state
     Maroon color with underline on hover
     =================================================================== */
  .shopify-section-group-footer .menu__item a:hover {
    color: rgba(104, 0, 64, 0.7);
    text-decoration: underline;
  }

  /* ===================================================================
     FOOTER GROUP — menu heading font weight
     Headings use bold weight per design
     =================================================================== */
  .shopify-section-group-footer .menu__heading__default {
    font-weight: 700;
  }
</style>
