<section
  id="Section-{{ section.id }}"
  class="press-mentions section section--full-width"
  style="
    --pm-bg: {{ section.settings.background_color }};
    --pm-padding-top: {{ section.settings.padding-block-start }}px;
    --pm-padding-bottom: {{ section.settings.padding-block-end }}px;
    --pm-logo-height: {{ section.settings.logo_height }}px;
    --pm-gap: {{ section.settings.gap }}px;
    --pm-gap-mobile: {{ section.settings.gap_mobile }}px;
    --pm-duration: {{ section.settings.scroll_duration }}s;
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="press-mentions__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="press-mentions__inner">
      <div class="press-mentions__track">
        {%- for copy in (1..2) -%}
          <div class="press-mentions__set"{% if copy == 2 %} aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              {%- if block.settings.image != blank -%}
                <img
                  class="press-mentions__logo"
                  src="{{ block.settings.image | image_url: width: 300 }}"
                  alt="{{ block.settings.alt_text | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                  {{ block.shopify_attributes }}
                >
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .press-mentions {
    position: relative;
    background-color: var(--pm-bg, #a31c69);
    padding-block-start: calc(var(--pm-padding-top) / 2);
    padding-block-end: calc(var(--pm-padding-bottom) / 2);
    overflow-x: clip;
  }

  @media screen and (min-width: 750px) {
    .press-mentions {
      padding-block-start: var(--pm-padding-top);
      padding-block-end: var(--pm-padding-bottom);
    }
  }

  .press-mentions__heading {
    text-align: center;
    color: #ffffff;
    margin: 0 0 16px;
    font-size: 18px;
    line-height: 1.3;
  }

  .press-mentions__inner {
    overflow: hidden;
    padding-block-start: 16px;
    padding-block-end: 5px;
  }

  @media screen and (max-width: 749px) {
    .press-mentions__inner {
      padding-block-start: 16px;
      padding-block-end: 32px;
    }
  }

  .press-mentions__track {
    display: flex;
    width: max-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    .press-mentions__track {
      animation: press-mentions-marquee var(--pm-duration, 36s) linear infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .press-mentions__track {
      animation-play-state: paused;
    }
  }

  .press-mentions__set {
    display: flex;
    align-items: center;
    gap: var(--pm-gap, 198px);
    padding-inline-end: var(--pm-gap, 198px);
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .press-mentions__set {
      gap: var(--pm-gap-mobile, 56px);
      padding-inline-end: var(--pm-gap-mobile, 56px);
    }
  }

  .press-mentions__logo {
    max-height: var(--pm-logo-height, 20px);
    width: auto;
    height: auto;
    max-width: 100%;
    flex-shrink: 0;
    object-fit: contain;
  }

  @keyframes press-mentions-marquee {
    0% {
      transform: translateZ(0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Press mentions",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#a31c69"
    },
    {
      "type": "header",
      "content": "Logo sizing"
    },
    {
      "type": "number",
      "id": "logo_height",
      "label": "Logo height",
      "default": 20
    },
    {
      "type": "number",
      "id": "gap",
      "label": "Gap between logos",
      "default": 198
    },
    {
      "type": "number",
      "id": "gap_mobile",
      "label": "Gap between logos (mobile)",
      "default": 56
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_duration",
      "label": "Scroll duration",
      "info": "Duration in seconds for one full cycle. Lower is faster.",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 36,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Press logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press mentions",
      "settings": {
        "background_color": "#a31c69",
        "logo_height": 20,
        "gap": 198,
        "gap_mobile": 56,
        "scroll_duration": 36,
        "padding-block-start": 40,
        "padding-block-end": 40
      },
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "alt_text": "Press logo 1"
          }
        },
        {
          "type": "logo",
          "settings": {
            "alt_text": "Press logo 2"
          }
        },
        {
          "type": "logo",
          "settings": {
            "alt_text": "Press logo 3"
          }
        },
        {
          "type": "logo",
          "settings": {
            "alt_text": "Press logo 4"
          }
        }
      ]
    }
  ]
}
{% endschema %}
