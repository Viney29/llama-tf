    color: var(--ho-cta-text);
    border: none;
    border-radius: 24px;
    cursor: pointer;
    transition: opacity 0.2s;
    align-self: center;
  }

  .hero-offer__add-btn:hover {
    opacity: 0.9;
  }

  .hero-offer__add-btn:focus-visible {
    outline: 2px solid var(--ho-accent);
    outline-offset: 2px;
  }

  .hero-offer__add-btn--loading {
    opacity: 0.7;
    pointer-events: none;
  }

  .hero-offer__add-btn-label {
    font-family: "poppins bold", sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 14px;
    color: inherit;
