  .hero-offer__add-btn-prices {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .hero-offer__add-btn-compare {
    font-family: "poppins bold", sans-serif;
    font-size: 12px;
    line-height: 20px;
    text-decoration: line-through;
    color: inherit;
  }

  .hero-offer__add-btn-price {
    font-family: "poppins bold", sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 14px;
    color: inherit;
  }

  /* Additional info */
  .hero-offer__additional {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }

  .hero-offer__additional-item {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--ho-accent);
  }

  .hero-offer__additional-item svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .hero-offer__additional-text {
    font-family: "ff good pro narrow", sans-serif;
    font-size: 12px;
    line-height: 18px;
    color: var(--ho-text);
  }

  /* Empty state */
  .hero-offer__empty {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 64px 16px;
    text-align: center;
  }

  .hero-offer__empty p {
    font-family: "ff good pro narrow", sans-serif;
    font-size: 16px;
    color: var(--ho-accent);
    opacity: 0.6;
    margin: 0;
  }

  /* ── Desktop (min-width: 750px) ── */
  @media screen and (min-width: 750px) {
    .hero-offer {
      padding-inline: 64px;
      padding-block: var(--ho-padding-top) var(--ho-padding-bottom);
    }

    .hero-offer__container {
      flex-direction: row;
      border-radius: 12px;
      overflow: hidden;
    }

    .hero-offer__gallery {
      width: 50%;
    }

    .hero-offer__gallery-wrapper {
      gap: 24px;
      padding: 16px 16px 24px;
      height: 100%;
    }

    .hero-offer__gallery-main {
      flex: 1 1 0%;
    }

    .hero-offer__slide {
      padding: 40px;
    }

    .hero-offer__thumbnails {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      padding: 10px;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .hero-offer__thumbnails::-webkit-scrollbar {
      display: none;
    }

    .hero-offer__thumbnail {
      width: 72px;
      height: 72px;
      flex-shrink: 0;
      padding: 12px;
      background-color: #ffffff;
      border: 1px solid transparent;
      border-radius: 6px;
      cursor: pointer;
      transition: border-color 0.15s;
      overflow: hidden;
      appearance: none;
      box-sizing: border-box;
    }

    .hero-offer__thumbnail:focus-visible {
      outline: 1px auto rgb(0, 95, 204);
    }

    .hero-offer__thumbnail--active {
      border-color: var(--ho-accent);
    }

    .hero-offer__thumbnail-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .hero-offer__details {
      width: 50%;
      flex-shrink: 0;
      padding: 35px 64px;
    }

    .hero-offer__title {
      font-size: 32px;
      line-height: 40px;
    }

    .hero-offer__add-btn {
      max-width: 480px;
      padding: 0 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-offer__gallery-track {
      scroll-behavior: auto;
    }

    .hero-offer__add-btn {
      transition: none;
    }

    .hero-offer__thumbnail {
      transition: none;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    class HeroOfferSection extends HTMLElement {
      connectedCallback() {
        this.gallery = this.querySelector('.hero-offer__gallery-track');
        this.slides = this.querySelectorAll('.hero-offer__slide');
        this.thumbnails = this.querySelectorAll('.hero-offer__thumbnail');
        this.addBtn = this.querySelector('.hero-offer__add-btn');

        if (this.thumbnails.length > 0) {
          this.setupThumbnails();
          this.setupObserver();
        }

        if (this.addBtn) {
          this.setupAddToCart();
        }
      }

      setupThumbnails() {
        for (const thumb of this.thumbnails) {
          thumb.addEventListener('click', () => {
            var index = parseInt(thumb.dataset.index, 10);
            var slide = this.slides[index];
            if (slide && this.gallery) {
              slide.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
            }
          });
        }
      }

      setupObserver() {
        if (!this.gallery || this.slides.length === 0) return;

        var self = this;
        var observer = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                var idx = parseInt(entries[i].target.dataset.index, 10);
                self.setActiveThumb(idx);
              }
            }
          },
          { root: this.gallery, threshold: 0.5 }
        );

        for (var j = 0; j < this.slides.length; j++) {
          observer.observe(this.slides[j]);
        }
      }

      setActiveThumb(index) {
        for (var i = 0; i < this.thumbnails.length; i++) {
          var thumb = this.thumbnails[i];
          var isActive = parseInt(thumb.dataset.index, 10) === index;
          thumb.classList.toggle('hero-offer__thumbnail--active', isActive);
          thumb.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        }
      }

      setupAddToCart() {
        var self = this;
        this.addBtn.addEventListener('click', function (e) {
          e.preventDefault();
          var variantId = self.addBtn.dataset.variantId;
          if (!variantId) return;

          self.addBtn.disabled = true;
          self.addBtn.classList.add('hero-offer__add-btn--loading');

          var url = (window.Theme && window.Theme.routes && window.Theme.routes.cart_add_url) || '/cart/add.js';
          var body = {
            items: [
              {
                id: parseInt(variantId, 10),
                quantity: 1
              }
            ]
          };

          var sellingPlan = self.addBtn.dataset.sellingPlan;
          if (sellingPlan) {
            body.items[0].selling_plan = parseInt(sellingPlan, 10);
          }

          fetch(url, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(body)
          })
            .then(function (res) {
              if (!res.ok) throw new Error('Add to cart failed');
              document.dispatchEvent(new CustomEvent('cart:refresh'));
              document.dispatchEvent(new CustomEvent('cart:change'));
            })
            .catch(function (err) {
              console.error('Hero offer ATC error:', err);
            })
            .finally(function () {
              self.addBtn.disabled = false;
              self.addBtn.classList.remove('hero-offer__add-btn--loading');
            });
        });
      }
    }

    if (!customElements.get('hero-offer-section')) {
      customElements.define('hero-offer-section', HeroOfferSection);
    }
  })();
</script>

