<div
  id="Section-{{ section.id }}"
  class="mc section section--full-width"
  style="
    --mc-bg: {{ section.settings.background_color }};
    --mc-heading-color: {{ section.settings.heading_color }};
    --mc-card-text-color: {{ section.settings.card_text_color }};
    --mc-padding-top: {{ section.settings.padding-block-start }}px;
    --mc-padding-bottom: {{ section.settings.padding-block-end }}px;
    overflow-x: clip;
  "
>
  <div class="mc__inner">
    <div class="mc__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="mc__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="mc__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="mc__grid" id="mc-grid-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="mc__card-outer" {{ block.shopify_attributes }}>
            <div class="mc__card">
              {%- if block.settings.icon != blank -%}
                <div class="mc__icon">
                  {{ block.settings.icon | image_url: width: 100 | image_tag: loading: 'lazy', class: 'mc__icon-img' }}
                </div>
              {%- elsif block.settings.icon_asset != blank -%}
                <div class="mc__icon">
                  <img
                    src="{{ block.settings.icon_asset | asset_url }}"
                    alt=""
                    loading="lazy"
                    class="mc__icon-img"
                  >
                </div>
              {%- endif -%}

              {%- if block.settings.photo != blank -%}
                <figure class="mc__photo-figure">
                  <div class="mc__photo-wrapper">
                    {%- assign photo_sizes = '(min-width: 750px) 96px, 76px' -%}
                    {{ block.settings.photo | image_url: width: block.settings.photo.width | image_tag: sizes: photo_sizes, widths: '76,96,152,192', loading: 'lazy', class: 'mc__photo-img' }}
                  </div>
                </figure>
              {%- endif -%}

              <div class="mc__text">
                {%- if block.settings.name != blank -%}
                  <h3 class="mc__name">{{ block.settings.name | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.credential != blank -%}
                  <p class="mc__credential">{{ block.settings.credential | escape }}</p>
                {%- endif -%}
                {%- if block.settings.quote != blank -%}
                  <div class="mc__quote">
                    <p>{{ block.settings.quote | escape }}</p>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="mc__scrollbar" id="mc-scrollbar-{{ section.id }}">
        <div class="mc__scrollbar-drag" id="mc-scrollbar-drag-{{ section.id }}"></div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var grid = document.getElementById('mc-grid-' + sectionId);
    var scrollbar = document.getElementById('mc-scrollbar-' + sectionId);
    var drag = document.getElementById('mc-scrollbar-drag-' + sectionId);

    if (!grid || !scrollbar || !drag) return;

    function update() {
      var scrollW = grid.scrollWidth;
      var clientW = grid.clientWidth;

      if (scrollW <= clientW) {
        scrollbar.style.display = 'none';
        return;
      }

      scrollbar.style.display = '';
      var trackW = scrollbar.clientWidth;
      var dragW = Math.max(30, (clientW / scrollW) * trackW);
      var maxScroll = scrollW - clientW;
      var scrollLeft = grid.scrollLeft;
      var maxDragLeft = trackW - dragW;
      var dragLeft = maxScroll > 0 ? (scrollLeft / maxScroll) * maxDragLeft : 0;

      drag.style.width = dragW + 'px';
      drag.style.transform = 'translateX(' + dragLeft + 'px)';
    }

    grid.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    if (typeof requestAnimationFrame !== 'undefined') {
      requestAnimationFrame(update);
    }
  })();
</script>

{% stylesheet %}
  /* ── Multi-column section ── */
  .mc {
    position: relative;
    background-color: var(--mc-bg, #a31c69);
    color: var(--mc-heading-color, #ffffff);
    z-index: 0;
  }

  .mc__inner {
    position: relative;
    max-width: 1335px;
    margin: 0 auto;
    padding: 48px 20px var(--mc-padding-bottom) 20px;
    color: var(--mc-heading-color, #ffffff);
    z-index: 0;
  }

  /* ── Introduction ── */
  .mc__intro {
    text-align: center;
  }

  .mc__heading {
    font-family: "poppins bold", sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
    color: var(--mc-heading-color, #ffffff);
    margin: 0;
  }

  .mc__subheading {
    font-family: "ff good pro narrow", sans-serif;
    font-size: 16px;
    line-height: 23.2px;
    text-align: center;
    color: var(--mc-heading-color, #ffffff);
    margin: 12px 0 28px 0;
  }

  /* ── Grid / Carousel ── */
  .mc__grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .mc__grid::-webkit-scrollbar {
    display: none;
  }

  .mc__card-outer {
    display: flex;
    position: relative;
    align-items: center;
    flex: 0 0 calc(100% - 40px);
    padding-top: 40px;
    margin-right: 16px;
    scroll-snap-align: start;
  }

  .mc__card-outer:last-child {
    margin-right: 0;
  }

  /* ── Card ── */
  .mc__card {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    padding: 16px 20px 34px 20px;
    background: #ffffff;
    border: 1px solid #ffffff;
    border-radius: 14px;
    color: var(--mc-card-text-color, #680040);
  }

  /* ── Decorative icon ── */
  .mc__icon {
    display: flex;
    position: absolute;
    top: 5px;
    left: 15px;
    transform: translateY(-100%);
    pointer-events: none;
  }

  .mc__icon-img {
    max-width: 50px;
    height: auto;
    display: block;
  }

  /* ── Photo ── */
  .mc__photo-figure {
    display: flex;
    position: relative;
    justify-content: center;
    margin: -56px 0 0 0;
    padding: 0;
  }

  .mc__photo-wrapper {
    display: flex;
    width: 80px;
    height: 80px;
    border: 2px solid #ffffff;
    border-radius: 999px;
    overflow: hidden;
  }

  .mc__photo-img {
    display: inline-block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
  }

  /* ── Text content ── */
  .mc__text {
    text-align: center;
    color: var(--mc-card-text-color, #680040);
  }

  .mc__name {
    font-family: "poppins bold", sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
    color: var(--mc-card-text-color, #680040);
    margin: 0;
  }

  .mc__credential {
    font-family: "ff good pro narrow", sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 20.3px;
    text-align: center;
    text-transform: uppercase;
    color: var(--mc-card-text-color, #680040);
    margin: 6px 0 0 0;
  }

  .mc__quote {
    margin: 10px 0 0 0;
    max-width: 100%;
  }

  .mc__quote p {
    font-family: "ff good pro narrow", sans-serif;
    font-size: 16px;
    line-height: 23.2px;
    text-align: center;
    color: var(--mc-card-text-color, #680040);
    margin: 0;
  }

  /* ── Scrollbar (mobile) ── */
  .mc__scrollbar {
    display: flex;
    margin-top: 24px;
    width: 100%;
    height: 3px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 10px;
    position: relative;
    z-index: 50;
  }

  .mc__scrollbar-drag {
    position: relative;
    height: 5px;
    top: -1px;
    background: #ffffff;
    border-radius: 10px;
    will-change: transform, width;
  }

  /* ── Desktop (min-width: 750px) ── */
  @media screen and (min-width: 750px) {
    .mc__inner {
      padding: var(--mc-padding-top) 40px var(--mc-padding-bottom) 40px;
    }

    .mc__heading {
      font-size: 36px;
      line-height: 39.6px;
    }

    .mc__subheading {
      margin-bottom: 32px;
    }

    .mc__grid {
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 28px 32px;
      overflow-x: visible;
      scroll-snap-type: none;
    }

    .mc__card-outer {
      flex: 0 0 calc(33.333% - 22px);
      max-width: calc(33.333% - 22px);
      margin-right: 0;
      padding-top: 50px;
      scroll-snap-align: unset;
    }

    .mc__photo-figure {
      margin-top: -66px;
    }

    .mc__photo-wrapper {
      width: 100px;
      height: 100px;
    }

    .mc__name {
      font-size: 20px;
      line-height: 22px;
    }

    .mc__scrollbar {
      display: none;
    }
  }
{% endstylesheet %}

