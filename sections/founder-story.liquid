<section
  id="Section-{{ section.id }}"
  class="founder-story section section--full-width"
  style="
    --fs-padding-top: {{ section.settings.padding-block-start }}px;
    --fs-padding-bottom: {{ section.settings.padding-block-end }}px;
    --fs-bg: {{ section.settings.background_color }};
    --fs-heading-color: {{ section.settings.heading_color }};
    --fs-body-color: {{ section.settings.body_text_color }};
    --fs-body-color-mobile: {{ section.settings.body_text_color_mobile }};
    --fs-button-bg: {{ section.settings.button_background_color }};
    --fs-button-text: {{ section.settings.button_text_color }};
  "
>
  <div class="founder-story__inner">
    <div class="founder-story__content">
      <div class="founder-story__title">
        {%- if section.settings.heading != blank -%}
          <h2 class="founder-story__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.body_text_desktop != blank -%}
          <p class="founder-story__body--desktop">{{ section.settings.body_text_desktop | escape }}</p>
        {%- endif -%}

        {%- if section.settings.body_text_mobile != blank -%}
          <p class="founder-story__body--mobile">{{ section.settings.body_text_mobile | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.button_text != blank -%}
        <a
          {%- if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {%- endif %}
          class="founder-story__button founder-story__button--desktop"
          aria-label="{{ section.settings.button_text | escape }}"
        >
          {{ section.settings.button_text | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.image_desktop != blank or section.settings.image_mobile != blank -%}
      <div class="founder-story__media">
        <picture>
          {%- if section.settings.image_desktop != blank -%}
            <source
              media="(min-width: 750px)"
              srcset="{{ section.settings.image_desktop | image_url: width: section.settings.image_desktop.width }}"
            >
          {%- endif -%}
          {%- if section.settings.image_mobile != blank -%}
            {{
              section.settings.image_mobile
              | image_url: width: section.settings.image_mobile.width
              | image_tag:
                class: 'founder-story__image',
                loading: 'lazy',
                alt: section.settings.heading
            }}
          {%- elsif section.settings.image_desktop != blank -%}
            {{
              section.settings.image_desktop
              | image_url: width: section.settings.image_desktop.width
              | image_tag:
                class: 'founder-story__image',
                loading: 'lazy',
                alt: section.settings.heading
            }}
          {%- endif -%}
        </picture>
      </div>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <a
        {%- if section.settings.button_link != blank %}
          href="{{ section.settings.button_link }}"
        {%- endif %}
        class="founder-story__button founder-story__button--mobile"
        aria-label="{{ section.settings.button_text | escape }}"
      >
        {{ section.settings.button_text | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ── Founder Story section ── */
  .founder-story {
    position: relative;
    background-color: var(--fs-bg);
    color: var(--fs-heading-color);
    z-index: 0;
  }

  .founder-story__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 56px 16px;
    max-width: 1366px;
  }

  .founder-story__content {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .founder-story__title {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .founder-story__heading {
    font-family: "poppins bold", sans-serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 40px;
    color: var(--fs-heading-color);
    margin: 0;
  }

  .founder-story__body--desktop {
    display: none;
    font-family: "ff good pro narrow", sans-serif;
    font-size: 16px;
    line-height: 1.45;
    color: var(--fs-body-color);
    margin: 0;
  }

  .founder-story__body--mobile {
    display: block;
    font-family: "ff good pro narrow", sans-serif;
    font-size: 16px;
    line-height: 1.45;
    color: var(--fs-body-color-mobile);
    margin: 0;
  }

  .founder-story__media {
    padding: 0 4px;
  }

  .founder-story__image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .founder-story__button {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px 24px;
    min-height: 48px;
    width: 100%;
    max-width: 358px;
    background-color: var(--fs-button-bg);
    color: var(--fs-button-text);
    border: 1px solid transparent;
    border-radius: 24px;
    font-family: "poppins bold", sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 14px;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .founder-story__button:focus-visible {
    outline: 1px auto rgb(229, 151, 0);
    outline-offset: 1px;
  }

  .founder-story__button--desktop {
    display: none;
  }

  .founder-story__button--mobile {
    display: flex;
  }

  /* ── Desktop (min-width: 750px) ── */
  @media screen and (min-width: 750px) {
    .founder-story__inner {
      flex-direction: row;
      align-items: center;
      gap: 64px;
      padding: var(--fs-padding-top) 64px var(--fs-padding-bottom) 64px;
      margin: 0 auto;
    }

    .founder-story__content {
      order: 2;
      flex: 1 1 0%;
    }

    .founder-story__media {
      order: 1;
      flex: 1 1 0%;
    }

    .founder-story__title {
      gap: 12px;
    }

    .founder-story__heading {
      font-size: 40px;
      line-height: 48px;
    }

    .founder-story__body--desktop {
      display: block;
    }

    .founder-story__body--mobile {
      display: none;
    }

    .founder-story__button--desktop {
      display: flex;
    }

    .founder-story__button--mobile {
      display: none;
    }

    .founder-story__button:focus-visible {
      outline-color: rgb(0, 95, 204);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Founder story",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built by dads. Backed by science."
    },
    {
      "type": "textarea",
      "id": "body_text_desktop",
      "label": "Body text (desktop)",
      "default": "Frustrated by sugary, artificial vitamins, dads Kevin & Brad created a truly healthy option for their kids and yours."
    },
    {
      "type": "textarea",
      "id": "body_text_mobile",
      "label": "Body text (mobile)",
      "default": "Kevin and Brad are two dads who couldn't find a clean vitamin for their kids. Everything was packed with added sugar cane, synthetic vitamins, and ingredients disguised as \"healthy.\" So they tested 75+ batches and created a real-fruit gummy that was closer to food than candy."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#680040"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Body text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "body_text_color_mobile",
      "label": "Body text color (mobile)",
      "default": "#4B413A"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#9ED7EF"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#680040"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 72,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Founder story",
      "settings": {
        "heading": "Built by dads. Backed by science.",
        "body_text_desktop": "Frustrated by sugary, artificial vitamins, dads Kevin & Brad created a truly healthy option for their kids and yours.",
        "body_text_mobile": "Kevin and Brad are two dads who couldn't find a clean vitamin for their kids. Everything was packed with added sugar cane, synthetic vitamins, and ingredients disguised as \"healthy.\" So they tested 75+ batches and created a real-fruit gummy that was closer to food than candy.",
        "button_text": "Read our story",
        "heading_color": "#680040",
        "body_text_color": "#000000",
        "body_text_color_mobile": "#4B413A",
        "background_color": "#9ED7EF",
        "button_background_color": "#680040",
        "button_text_color": "#FFFFFF",
        "padding-block-start": 72,
        "padding-block-end": 72
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
