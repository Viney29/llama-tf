<section
  id="Section-{{ section.id }}"
  class="custom-faq section section--full-width"
  style="
    --cf-padding-top: {{ section.settings.padding-block-start }}px;
    --cf-padding-bottom: {{ section.settings.padding-block-end }}px;
    --cf-bg: {{ section.settings.background_color }};
    --cf-heading-color: {{ section.settings.heading_color }};
    --cf-text-color: {{ section.settings.text_color }};
  "
>
  <div class="custom-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="custom-faq__heading ff-heading ff-secondary">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="custom-faq__list">
        {%- for block in section.blocks -%}
          <div class="custom-faq__item" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="custom-faq__trigger ff-body"
              aria-expanded="false"
              aria-controls="CustomFaqAnswer-{{ section.id }}-{{ block.id }}"
            >
              <span class="custom-faq__question">{{ block.settings.question | escape }}</span>
              <span class="custom-faq__icon" aria-hidden="true"></span>
            </button>
            <div
              id="CustomFaqAnswer-{{ section.id }}-{{ block.id }}"
              class="custom-faq__answer rte ff-body"
              role="region"
            >
              <div class="custom-faq__answer-inner">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('Section-{{ section.id }}');
    if (!section) return;

    var triggers = section.querySelectorAll('.custom-faq__trigger');

    for (var i = 0; i < triggers.length; i++) {
      triggers[i].addEventListener('click', function () {
        var item = this.closest('.custom-faq__item');
        var isOpen = item.classList.contains('is-open');
        var answer = item.querySelector('.custom-faq__answer');
        var answerInner = item.querySelector('.custom-faq__answer-inner');

        if (isOpen) {
          item.classList.remove('is-open');
          this.setAttribute('aria-expanded', 'false');
          answer.style.maxHeight = '0px';
        } else {
          item.classList.add('is-open');
          this.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answerInner.scrollHeight + 'px';
        }
      });
    }
  })();
</script>

{% stylesheet %}
  /* ── Custom FAQ section ── */
  .custom-faq {
    position: relative;
    padding-block: calc(var(--cf-padding-top) / 2) calc(var(--cf-padding-bottom) / 2);
    background-color: var(--cf-bg);
    color: var(--cf-heading-color);
    z-index: 0;
  }

  .custom-faq__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-inline: 16px;
    color: var(--cf-heading-color);
  }

  /* ── Heading ── */
  .custom-faq__heading {
    font-family: "poppins bold", sans-serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 40px;
    text-align: center;
    color: var(--cf-heading-color);
    margin: 0;
  }

  /* ── FAQ List ── */
  .custom-faq__list {
    color: var(--cf-heading-color);
  }

  /* ── FAQ Item ── */
  .custom-faq__item {
    border-bottom: 1px solid rgba(0, 62, 107, 0.2);
  }

  /* ── Trigger button ── */
  .custom-faq__trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    width: 100%;
    background: none;
    border: none;
    color: var(--cf-text-color);
    font-family: "ff good pro narrow", sans-serif;
    font-size: 18px;
    line-height: 26.1px;
    text-align: left;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }

  .custom-faq__trigger:focus-visible {
    outline: 1px auto rgb(0, 95, 204);
  }

  /* ── Question text ── */
  .custom-faq__question {
    flex: 1 1 0%;
    color: var(--cf-text-color);
    font-family: "ff good pro narrow", sans-serif;
    font-size: 18px;
    line-height: 26.1px;
    text-align: left;
  }

  /* ── Plus / Minus icon ── */
  .custom-faq__icon {
    position: relative;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .custom-faq__icon::before,
  .custom-faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background-color: var(--cf-text-color);
    transition: transform 0.3s ease;
  }

  /* Horizontal bar */
  .custom-faq__icon::before {
    width: 14px;
    height: 1.6px;
    transform: translate(-50%, -50%);
  }

  /* Vertical bar — rotates to 0 when open */
  .custom-faq__icon::after {
    width: 1.6px;
    height: 14px;
    transform: translate(-50%, -50%);
  }

  .custom-faq__item.is-open .custom-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  /* ── Answer panel ── */
  .custom-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .custom-faq__answer-inner {
    padding-bottom: 20px;
    max-width: 900px;
    color: var(--cf-text-color);
  }

  .custom-faq__answer-inner p {
    font-family: "ff good pro narrow", sans-serif;
    font-size: 16px;
    line-height: 23.2px;
    color: var(--cf-text-color);
    margin: 0;
  }

  /* ── Desktop (min-width: 750px) ── */
  @media screen and (min-width: 750px) {
    .custom-faq {
      padding-block: var(--cf-padding-top) var(--cf-padding-bottom);
    }

    .custom-faq__inner {
      gap: 32px;
      padding-inline: 256px;
    }

    .custom-faq__heading {
      font-size: 40px;
      line-height: 48px;
    }

    .custom-faq__trigger {
      font-size: 20px;
      line-height: 29px;
    }

    .custom-faq__question {
      font-size: 20px;
      line-height: 29px;
    }
  }
{% endstylesheet %}

