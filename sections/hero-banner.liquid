    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Starter Pack"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
